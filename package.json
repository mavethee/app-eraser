{
  "name": "app-eraser",
  "version": "1.0.1",
  "description": "A utility to safely remove Mac application support files.",
  "main": "app.js",
  "author": "David H, mavethee",
  "license": "ISC",
  "build": {
    "productName": "App Eraser",
    "appId": "com.apperaser.app",
    "mac": {
      "icon": "resources/app-eraser.icns",
      "category": "public.app-category.utilities"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "prerelease"
      }
    ]
  },
  "scripts": {
    "start": "export NODE_ENV=development&&electron .",
    "test": "jest",
    "lint": "eslint .",
    "dist": "npm version patch && npm run release",
    "build": "npm run clean && electron-builder -m --universal true",
    "release": "npm run clean && electron-builder -p always -m --universal true",
    "clean": "rm -rf dist",
    "version": "git add -A",
    "postversion": "git push && git push --tags"
  },
  "pre-commit": [
    "lint",
    "test"
  ],
  "dependencies": {
    "electron-updater": "^6.6.2",
    "file-icon": "^4.0.0",
    "trash": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^39.2.2",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "jest": "^29.3.1",
    "pre-commit": "^1.0.10"
  },
  "overrides": {
    "cross-spawn": "^7.0.6"
  },
  "volta": {
    "node": "22.21.1"
  }
}